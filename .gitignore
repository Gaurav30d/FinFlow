### =========================================================================
### FinFlow - Production .gitignore
### Stack: Java 21 / Spring Boot Multi-Module / IntelliJ IDEA / macOS
### =========================================================================

# -------------------------------------------------------------------------
# Operating System Files
# -------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows (for cross-platform team members)
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# -------------------------------------------------------------------------
# Java & JVM Runtime Artifacts
# -------------------------------------------------------------------------
*.class
*.ctxt
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash & dump logs
hs_err_pid*
replay_pid*

# Java profiler & flight recorder files
*.hprof
*.jfr

# -------------------------------------------------------------------------
# Build Tools: Maven (Multi-Module Support)
# -------------------------------------------------------------------------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties

# DO NOT ignore Maven Wrapper files
!mvnw
!mvnw.cmd
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# -------------------------------------------------------------------------
# Build Tools: Gradle (Multi-Module Support / Hybrid)
# -------------------------------------------------------------------------
.gradle/
build/
out/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat

# -------------------------------------------------------------------------
# IDE: IntelliJ IDEA
# -------------------------------------------------------------------------
# User-specific files and caches
.idea/
*.iws
*.iml
*.ipr
out/

# If your team shares IntelliJ code style or run configurations,
# uncomment the lines below:
# !.idea/
# !.idea/runConfigurations/
# !.idea/codeStyles/
# !.idea/copyright/
# !.idea/misc.xml
# !.idea/vcs.xml
# .idea/**/workspace.xml
# .idea/**/tasks.xml
# .idea/**/usage.statistics.xml
# .idea/**/dictionaries
# .idea/**/shelf

# Eclipse & NetBeans (for cross-IDE compatibility)
.classpath
.project
.settings/
.springBeans
nbproject/
nb-configuration.xml

# Visual Studio Code
.vscode/

# -------------------------------------------------------------------------
# Spring Boot Specifics
# -------------------------------------------------------------------------
# Spring Boot DevTools restart trigger marker
.spring-boot-devtools.properties

# -------------------------------------------------------------------------
# Logs & Application Output
# -------------------------------------------------------------------------
*.log
*.log.*
logs/
log/
logstash/

# -------------------------------------------------------------------------
# Secrets, Environment & Credentials
# -------------------------------------------------------------------------
# Environment files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Preserve template/example files
!.env.example
!.env.template

# Keystores, certificates & private keys
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.crt
*.der

# Local secret property files
*secret*.properties
*secret*.yml
*secret*.yaml
application-local.properties
application-local.yml
application-local.yaml
application-secrets.properties
application-secrets.yml
application-secrets.yaml

# Cloud credentials
gcp-key.json
aws-credentials
credentials.json

# -------------------------------------------------------------------------
# Docker & Container Local Overrides
# -------------------------------------------------------------------------
# Local compose overrides
docker-compose.override.yml
docker-compose.override.yaml
docker-compose.local.yml
docker-compose.local.yaml

# Local data volumes & mounts
docker-data/
.docker/

# -------------------------------------------------------------------------
# Testing & Code Quality Tools
# -------------------------------------------------------------------------
# JaCoCo & coverage reports
*.exec
*.jacoco
jacoco.exec
coverage-reports/
target/site/jacoco/

# SonarQube & Checkstyle
.sonar/
.scannerwork/
checkstyle-result.xml

# -------------------------------------------------------------------------
# Scratch & Temporary Files
# -------------------------------------------------------------------------
scratch/
tmp/
temp/
*.swp
*.swo
*~
